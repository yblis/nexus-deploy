# ============================================================
# Nexus RMM — Configuration
# ============================================================
# Copiez ce fichier en .env et adaptez les valeurs.
#
#   cp .env.example .env
#
# IMPORTANT : Changez impérativement les mots de passe et le
# JWT_SECRET avant le premier démarrage.
# ============================================================

# ── Version ──
# Tag de l'image Docker à utiliser (ex: latest, 1.0.0, 1.2.3)
NEXUS_VERSION=latest

# ── Base de données PostgreSQL ──
POSTGRES_USER=nexus
POSTGRES_PASSWORD=CHENGE_ME
POSTGRES_DB=nexus

# ── Backend API ──
# Clé secrète pour les tokens JWT (minimum 32 caractères aléatoires)
# Générez avec : openssl rand -hex 32
JWT_SECRET=CHENGE_ME

# Port interne de l'API (ne pas modifier sauf besoin spécifique)
API_PORT=8080

# ── Réseau ──
# Domaine public de votre instance Nexus (ex: nexus.example.com)
NEXUS_DOMAIN=nexus.example.com

# IP publique du serveur (pour la connexion des agents)
# Laisser vide pour détection automatique
NEXUS_SERVER_IP=

BACKEND_URL=nexus-api:8080

# ── Frontend ──
# Port d'écoute du dashboard web sur le serveur hôte
WEB_PORT=3333

# ── Nexus Network Relay (optionnel) ──
# Relais de secours quand le P2P échoue entre agents.
# Activation : docker compose --profile relay up -d
#
# Méthode recommandée — enrôlement automatique : générez une clé dans le
# dashboard (Nexus Network > Relais > menu du relais > Clé d'enrôlement),
# le relais récupère et conserve seul son identifiant et son token.
NEXUS_RELAY_ENROLL_KEY=

# Méthode manuelle (alternative) : identifiant et token affichés à la
# création du relais dans le dashboard. Laisser vide si enrôlement auto.
NEXUS_RELAY_ID=
NEXUS_RELAY_TOKEN=

# URL de l'API Nexus vue par le relais (défaut : API interne du compose)
NEXUS_RELAY_SERVER_URL=http://nexus-api:8080

# Certificat TLS du relais (chemins DANS le conteneur, à monter en volume).
# Laisser vide pour un certificat auto-signé (les agents devront alors
# être configurés en conséquence).
NEXUS_RELAY_CERT=
NEXUS_RELAY_KEY=

# Ne JAMAIS activer en production (désactive la vérification TLS)
NEXUS_RELAY_ALLOW_INSECURE=

# Ports exposés sur le serveur hôte (à ouvrir sur le firewall)
NEXUS_RELAY_QUIC_PORT=51821
NEXUS_RELAY_STUN_PORT=3478
NEXUS_RELAY_WSS_PORT=8443
